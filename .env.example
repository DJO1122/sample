# ---------------------------------------------------------------------------
# Lead email (Resend) - required in production
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Where booking requests are delivered. Comma-separate for more than one.
LEAD_TO_EMAIL=sales@aerotelfibernet.com
# Must be an address on a domain verified in Resend.
LEAD_FROM_EMAIL="Aerotel Website <website@aerotelfibernet.com>"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile - required in production
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis) - strongly recommended in production
# Without these the API falls back to a per-instance in-memory window.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Optional: also append each lead to a private Google Sheet via Apps Script
# ---------------------------------------------------------------------------
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
